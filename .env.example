# Copy this file to .env and adjust per developer machine / environment.
# .env is gitignored (see .gitignore); .env.example is the committed template
# every clone starts from. webpack.config.mjs reads these via `dotenv` -- this
# file is the one place to look for "what can I configure centrally?".

# RENAME ME when you turn this template into a real MFE (README.md §1).
# Must match the key the Shell uses in its own `remotes` map.
MFE_NAME=example

# This MFE's standalone dev-server port (npm run dev). Each MFE needs its own;
# agree the number with whoever owns the Shell's dev setup so two MFEs never
# collide on one machine.
PORT=3001

# Base URL of this domain's backend service, baked into the bundle at build
# time as the __API_BASE_URL__ constant (see src/env.ts). Point it
# at the real lynkflow-{domain}-svc per environment. If unset, defaults to
# /api/${MFE_NAME}.
# API_BASE_URL=http://localhost:4001

# Language the standalone dev harness (npm run dev only) renders in -- "en"
# or "ar". In production the Shell passes language in at runtime instead
# (.claude/rules/i18n.md); this only affects this template's own dev build.
# Baked into the static HTML at build time -- restart `npm run dev` after
# changing it. See src/bootstrap.tsx.
DEV_LANGUAGE=en
