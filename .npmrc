# Registry mapping only -- safe to commit, contains no credential.
# Your auth token belongs in your GLOBAL ~/.npmrc, never here.
# See .claude/rules/publishing.md at the workspace root.
@lynkflow:registry=https://npm.pkg.github.com

# Required for @lynkflow/config (file: dependency) to install its own
# transitive deps instead of a bare symlink npm never installs into.
install-links=true
